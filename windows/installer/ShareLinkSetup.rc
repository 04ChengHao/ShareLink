// 享联 ShareLink 安装向导 —— Win32 资源脚本（图标 + 版本信息）
//
// 编译（工作目录为项目根，rc.exe 的相对路径基于工作目录解析）：
//   rc /nologo /fo dist\_setup.res windows\installer\ShareLinkSetup.rc
// 然后交由 csc 以 /win32res 写入安装包：
//   csc ... /win32res:dist\_setup.res windows\installer\ShareLinkSetup.cs ...
//
// 注意：块标识 "080404b0" 表示简体中文 + Unicode，中文串在资源管理器中可正常显示。

#pragma code_page(65001)

101 ICON "assets\\app_icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,1
PRODUCTVERSION 1,0,0,1
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ShareLink"
            VALUE "FileDescription", "享联 ShareLink 安装程序"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "ShareLink-Setup"
            VALUE "LegalCopyright", "Copyright (C) 2026 ShareLink"
            VALUE "OriginalFilename", "ShareLink-Setup-1.0.0-x64.exe"
            VALUE "ProductName", "享联 ShareLink"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END